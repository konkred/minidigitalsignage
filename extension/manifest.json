{
  "manifest_version": 3,
  "name": "Signage Player",
  "version": "1.2.0",
  "description": "Zeigt auf diesem Monitor die im Admin-Bereich zugewiesenen Inhalte an.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "power", "storage", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["cursor.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
